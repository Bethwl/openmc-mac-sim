<?xml version='1.0' encoding='UTF-8'?>
<settings>
  <run_mode>fixed source</run_mode>
  <particles>10000</particles>
  <batches>10</batches>
  <source type="independent" strength="1.0" particle="photon">
    <space type="point">
      <parameters>0.0 0.0 1.0</parameters>
    </space>
    <angle type="monodirectional" reference_uvw="0.0 0.0 1.0"/>
    <energy type="discrete">
      <parameters>60000.0 1.0</parameters>
    </energy>
  </source>
  <output>
    <path>run_sample_s8</path>
  </output>
  <electron_treatment>ttb</electron_treatment>
  <photon_transport>true</photon_transport>
  <cutoff>
    <energy_photon>1000.0</energy_photon>
  </cutoff>
</settings>
